<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:text="تکلیف ۵ اینترفیس با RecyclerView"
            android:textColor="#212121"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnInterface1"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="14dp"
            android:text="اینترفیس ۱ : کلیک ساده (لیست مخاطبین)"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnInterface2"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="14dp"
            android:text="اینترفیس ۲ : چند دکمه در آیتم (لیست محصولات)"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnInterface3"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="14dp"
            android:text="اینترفیس ۳ : چک‌باکس و تغییر وضعیت (وظایف)"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnInterface4"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="14dp"
            android:text="اینترفیس ۴ : کلیک طولانی برای حذف (یادداشت)"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnInterface5"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="14dp"
            android:text="اینترفیس ۵ : ریپلای و ارسال پیام (چت)"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
